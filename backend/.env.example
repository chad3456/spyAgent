# India Progress Dashboard - Environment Variables
# Copy this file to .env and fill in values as needed

# Optional: NewsAPI key for additional news sources
# Get your free key at https://newsapi.org/
NEWS_API_KEY=

# Optional: GNews API key for additional news sources
# Get your free key at https://gnews.io/
GNEWS_API_KEY=

# Server config
HOST=0.0.0.0
PORT=8000

# Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL=900

# Request timeout in seconds
REQUEST_TIMEOUT=30
